"""
Pulse monitor graph scaffold - PySimpleGUI

One plot area, one toggle. The toggle swaps the plot between:
    - Pulse (BPM over time)
    - Waveform (PPG amplitude over time)

No data is wired in yet. Each view draws empty axes with its labels and a
"No data yet" placeholder. To add data later, fill the buffers and call
refresh_plot().

    pip install PySimpleGUI matplotlib
"""
import tkinter
from tkinter import font
import PySimpleGUI as sg
import matplotlib
import time
matplotlib.use("TkAgg")
import matplotlib.pyplot as plt
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg
# --------------------------------------------------------------------------
# Settings to ensure GUI is updated 1/sec
# --------------------------------------------------------------------------
REFRESH_INTERVAL_S = 0.5   # redraw target: twice per second
MAX_ALLOWED_GAP_S = 1.0    # requirement: never longer than 1 s between refreshes
STALE_AFTER_S = 2.0        # no new data for this long -> treat the signal as lost
SELF_TEST = True           # prints a PASS/FAIL report after SELF_TEST_DURATION_S
SELF_TEST_DURATION_S = 10
# --------------------------------------------------------------------------
# View definitions: all labels and axis limits live here
# --------------------------------------------------------------------------

VIEWS = {
    "pulse": {
        "button_text": "Showing: Pulse (BPM)  -  click for Waveform",
        "title": "Pulse Rate",
        "xlabel": "Time (s)",
        "ylabel": "Heart rate (beats per minute)",
        "xlim": (0, 60),
        "ylim": (40, 140),
        "color": "#d6336c",
    },
    "waveform": {
        "button_text": "Showing: Waveform (PPG)  -  click for Pulse",
        "title": "Pulse Waveform (PPG)",
        "xlabel": "Time (ms)",
        "ylabel": "Amplitude (a.u.)",
        "xlim": (0, 10000),
        "ylim": (-0.2, 1.8),
        "color": "#1f6f8b",
    },
}

# Placeholders for when real data arrives: (x_values, y_values) per view
data = {
    "pulse": ([], []),
    "waveform": ([], []),
}
LOW_LIMIT = 50
HIGH_LIMIT = 100

ALARM_STYLES = {
    "idle": {"text": "ALARM: NO DATA", "bg": "#BDBDBD", "fg": "#222222"},
    "ok":   {"text": "PULSE OK",       "bg": "#4CAF50", "fg": "#FFFFFF"},
    "low":  {"text": "PULSE TOO LOW",  "bg": "#E53935", "fg": "#FFFFFF"},
    "high": {"text": "PULSE TOO HIGH", "bg": "#E53935", "fg": "#FFFFFF"},
}

# --------------------------------------------------------------------------
# Plot helpers
# --------------------------------------------------------------------------

def refresh_plot(ax, canvas, view_key):
    """Redraw the axes for the chosen view (labels, limits, any data)."""
    view = VIEWS[view_key]
    xs, ys = data[view_key]

    ax.clear()
    ax.set_title(view["title"])
    ax.set_xlabel(view["xlabel"])
    ax.set_ylabel(view["ylabel"])
    ax.set_xlim(*view["xlim"])
    ax.set_ylim(*view["ylim"])
    ax.grid(True, linestyle="--", alpha=0.4)

    if xs:
        ax.plot(xs, ys, color=view["color"])
    else:
        ax.text(0.5, 0.5, "No data yet", transform=ax.transAxes,
                ha="center", va="center", color="grey", fontsize=14)

    canvas.draw_idle()
def update_bpm(window, bpm):
    """Show the current pulse rate. Pass None when there is no reading."""
    window["-BPM-"].update("--" if bpm is None else f"{bpm:.1f}")
def get_alarm_state(bpm):
    if bpm is None:
        return "idle"
    if LOW_LIMIT is not None and bpm < LOW_LIMIT:
        return "low"
    if HIGH_LIMIT is not None and bpm > HIGH_LIMIT:
        return "high"
    if LOW_LIMIT is None and HIGH_LIMIT is None:
        return "idle"          # no limits set, so we can't judge
    return "ok"
def refresh_display(window, ax, canvas, view_key, bpm):
    update_bpm(window, bpm)
    update_alarm(window, bpm)
    refresh_plot(ax, canvas, view_key)
def update_alarm(window, bpm):
    style = ALARM_STYLES[get_alarm_state(bpm)]
    window["-ALARM-"].update(style["text"], background_color=style["bg"],
                             text_color=style["fg"])
# --------------------------------------------------------------------------
# Layout
# --------------------------------------------------------------------------


def build_layout():
    bpm_panel = [
    [sg.Text(ALARM_STYLES["idle"]["text"], key="-ALARM-", size=(18, 2),
             justification="center", font=("Any", 16, "bold"),
             background_color=ALARM_STYLES["idle"]["bg"],
             text_color=ALARM_STYLES["idle"]["fg"], pad=(0, (0, 20)))],
    [sg.Text("Current pulse", font=("Any", 14))],
    [sg.Text("--", key="-BPM-", font=("Any", 72, "bold"), size=(6, 2), justification="center")],
    [sg.Text("BPM", font=("Any", 18))],
]

    return [
        [sg.Text("Pulse Monitor", font=("Any", 20, "bold"))],
        [sg.Button(VIEWS["pulse"]["button_text"], key="-TOGGLE-", size=(42, 1))],
        [sg.Canvas(key="-CANVAS-"),
         sg.Column(bpm_panel, element_justification="center",
                   vertical_alignment="center", pad=(20, 0))], [sg.Text("Display refresh: --", key="-STATUS-", font=("Any", 9), text_color="grey")]
    ]

# --------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------

def main():
    window = sg.Window("Pulse Monitor", build_layout(), finalize=True)
    update_alarm(window, 120)    # red "PULSE TOO LOW" (once you've set LOW_LIMIT)
    update_bpm(window, 120)      # shows 30 in the big number
    fig, ax = plt.subplots(figsize=(7, 4))
    fig.tight_layout()
    canvas = FigureCanvasTkAgg(fig, master=window["-CANVAS-"].TKCanvas)
    canvas.get_tk_widget().pack(side="top", fill="both", expand=1)

    current_view = "pulse"
    refresh_plot(ax, canvas, current_view)

    latest_bpm = None            # set this when real data arrives
    last_data_time = None        # set to time.monotonic() when real data arrives

    start = last_refresh = time.monotonic()
    worst_gap = 0.0
    missed = 0

    while True:
        event, _ = window.read(timeout=100)
        if event == sg.WIN_CLOSED:
            break

        if event == "-TOGGLE-":
            current_view = "waveform" if current_view == "pulse" else "pulse"
            window["-TOGGLE-"].update(VIEWS[current_view]["button_text"])
            fig.tight_layout()
            last_refresh = 0     # force an immediate redraw of the new view

    # Later: read the queue here and update latest_bpm / last_data_time / data[...]

        now = time.monotonic()
        if now - last_refresh >= REFRESH_INTERVAL_S:
            gap = now - last_refresh if last_refresh else REFRESH_INTERVAL_S
            stale = last_data_time is None or (now - last_data_time) > STALE_AFTER_S
            refresh_display(window, ax, canvas, current_view,
                        None if stale else latest_bpm)
            last_refresh = now

            worst_gap = max(worst_gap, gap)
            if gap > MAX_ALLOWED_GAP_S:
                missed += 1
            window["-STATUS-"].update(
                f"Display refresh: last gap {gap:.2f} s, worst {worst_gap:.2f} s, "
                f"missed {missed}",
                text_color="red" if missed else "black")

    if SELF_TEST and now - start >= SELF_TEST_DURATION_S:
        verdict = "PASS" if worst_gap <= MAX_ALLOWED_GAP_S else "FAIL"
        print(f"SELF-TEST {verdict}: worst gap {worst_gap:.3f} s over "
              f"{SELF_TEST_DURATION_S} s (limit {MAX_ALLOWED_GAP_S} s)")
        SELF_TEST = False
    window.close()


if __name__ == "__main__":
    main()
